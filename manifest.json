{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.4.6",
  "author": "Christian Eichert",
  "developer": {
    "name": "Christian Eichert, Jesse Lujack, John Bieling"
  },
  "default_locale": "en-US",
  "browser_specific_settings": {
    "gecko": {
      "id": "iOSNotes@siliconvenice.net",
      "strict_min_version": "128.0"
    }
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "commands": {
    "open-ios-editor": {
      "suggested_key": {
        "default": "Ctrl+Q"
      },
      "description": "__MSG_editNote__"
    },
    "saveclose-ios-editor": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "__MSG_saveNote__"
    },
    "new-ios-note": {
      "suggested_key": {
        "default": "Ctrl+Alt+N"
      },
      "description": "__MSG_newNote__"
    }
  },
  "background": {
    "page": "background.html"
  },
  "browser_action": {
    "allowed_spaces": ["mail"],
    "default_title": "__MSG_refreshNotes__",
    "default_label": "__MSG_refreshNotes__",
    "default_icon": {
      "16": "images/iOSNotes.png",
      "32": "images/iOSNotes.png"
    }
  },
  "message_display_action": {
    "default_title": "__MSG_editNote__",
    "default_label": "__MSG_editNote__",
    "default_icon": {
      "16": "images/iOSNotes.png",
      "32": "images/iOSNotes.png"
    },
    "type": "button"
  },
  "icons": {
    "48": "images/iOSNotes.png"
  },
  "permissions": [
    "accountsFolders",
    "accountsRead",
    "messagesRead",
    "messagesImport",
    "messagesMove",
    "messagesDelete",
    "menus",
    "notifications",
    "scripting",
    "storage",
    "tabs"
  ]
}
